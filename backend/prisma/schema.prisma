// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(uuid())
  name             String
  stripeCustomerId String?
  subscriptionPlan String   @default("free") // free, pro, enterprise
  status           String   @default("active") // active, suspended
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              User[]
  productions        Production[]
  inventories        Inventory[]
  expenses           Expense[]
  sites              Site[]
  maintenances       Maintenance[]
  employees          Employee[]
  attendances        Attendance[]
  vehicles           Vehicle[]
  consumptions       Consumption[]
  vendors            Vendor[]
  purchaseOrders     PurchaseOrder[]
  challans           Challan[]
  vehicleMovements   VehicleMovement[]
  documents          Document[]
  auditLogs          AuditLog[]
  departments        Department[]
  materialCategories MaterialCategory[]
  vehicleTypes       VehicleType[]
  expenseCategories  ExpenseCategory[]
  unitsOfMeasure     UnitOfMeasure[]
  materialInwards    MaterialInward[]
  rmcGrades          RMCGrade[]
  scraps             Scrap[]
  overheadEntries    OverheadEntry[]
  customColumns      CustomColumn[]
  billOfMaterials    BillOfMaterial[]
  bomItems           BOMItem[]
  bomRevisions       BOMRevision[]
  customData         Json?
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user") // admin, manager, user
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Production {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  amount          Float
  unit            String   @default("cum") // cubic meters (cum) is primary for RMC
  grade           String? // RMC grade: M5, M10, M15, M20, M25, M30 etc.
  productionType  String? // Slab, Column, Transit Mixture, Foundation, etc.
  siteId          String?
  site            Site?    @relation(fields: [siteId], references: [id])
  notes           String?
  quality         String?
  towerName       String? // Building / tower / slab reference
  isRejected      Boolean  @default(false)
  rejectionReason String?
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Inventory {
  id             String   @id @default(uuid())
  itemName       String
  quantity       Float
  unit           String
  minThreshold   Float    @default(0)
  price          Float?
  category       String?
  sourceLocation String? // e.g. GGBS source
  brand          String? // e.g. Fly Ash brand
  mfgLocation    String? // manufacturing location (Fly Ash etc.)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Expense {
  id               String   @id @default(uuid())
  date             DateTime @default(now())
  category         String
  amount           Float
  description      String?
  paymentStatus    String   @default("paid") // paid, pending
  siteId           String?
  site             Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  allocationType   String   @default("unallocated") // plant_specific, shared, unallocated
  allocationMethod String?  // actual_usage, production_volume, operating_hours, manual
  voucherNumber    String?
  invoiceNumber    String?
  vendorName       String?
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Site {
  id              String           @id @default(uuid())
  name            String
  location        String?
  status          String           @default("active") // active, completed, on-hold
  clientName      String?
  managerName     String?
  budget          Float?           @default(5000000)
  spent           Float?           @default(0)
  progress        Float?           @default(0)
  startDate       DateTime?
  endDate         DateTime?
  description     String?
  customData      Json?
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  productions     Production[]
  consumptions    Consumption[]
  vehicles        Vehicle[]
  materialInwards MaterialInward[]
  scraps          Scrap[]
  overheadEntries OverheadEntry[]
  expenses        Expense[]
  billOfMaterials BillOfMaterial[]
  employees       Employee[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Maintenance {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  type        String // Routine, Repair, Breakdown
  cost        Float
  description String?
  status      String   @default("completed") // completed, pending
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id           String       @id @default(uuid())
  employeeCode String?
  name         String
  position     String
  department   String?
  designation  String?
  contact      String?
  salary       Float
  status       String       @default("active") // active, inactive
  joinedDate   DateTime     @default(now())
  siteId       String?
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  attendances  Attendance[]
  documents    Document[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Attendance {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  hoursWorked Float
  overtime    Float    @default(0)
  status      String   @default("present") // present, absent, leave
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id           String            @id @default(uuid())
  plateNumber  String
  model        String
  status       String            @default("available") // available, in-use, maintenance
  lastService  DateTime?
  vehicleType  String?
  driver       String?
  rentalAmount Float?            @default(0)
  siteId       String?
  site         Site?             @relation(fields: [siteId], references: [id])
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  maintenances Maintenance[]
  challans     Challan[]
  movements    VehicleMovement[]
  documents    Document[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([plateNumber, tenantId])
}

model Consumption {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  material        String
  amount          Float
  unit            String
  siteId          String?
  site            Site?    @relation(fields: [siteId], references: [id])
  isRejected      Boolean  @default(false)
  rejectionReason String?
  unitPrice       Float? // avg purchase/rate used for cost
  sourceLocation  String? // GGBS source location
  brand           String? // Fly Ash brand
  mfgLocation     String? // Fly Ash manufacturing location
  customData      Json?
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  contact        String?
  category       String?
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  orderNumber String
  date        DateTime @default(now())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  totalAmount Float
  status      String   @default("pending") // pending, received, cancelled
  items       String? // JSON string or summary
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orderNumber, tenantId])
}

model Challan {
  id            String     @id @default(uuid())
  challanNumber String
  date          DateTime   @default(now())
  vehicleId     String
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  material      String
  quantity      Float
  destination   String
  status        String     @default("pending") // pending, approved, dispatched, delivered
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  documents     Document[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([challanNumber, tenantId])
}

model VehicleMovement {
  id           String    @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  fromLocation String
  toLocation   String
  startTime    DateTime
  endTime      DateTime?
  distance     Float?
  fuelConsumed Float?
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Master Data Models
model Department {
  id       String @id @default(uuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

model MaterialCategory {
  id       String @id @default(uuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

model VehicleType {
  id       String @id @default(uuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

model ExpenseCategory {
  id       String @id @default(uuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

model UnitOfMeasure {
  id       String @id @default(uuid())
  name     String
  code     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

// Local File Uploads Model
model Document {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  fileType     String
  filePath     String
  fileSize     Int
  uploadedAt   DateTime @default(now())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  challanId  String?
  challan    Challan?  @relation(fields: [challanId], references: [id], onDelete: Cascade)
}

// Global Activity logs
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  details   String?
  userId    String
  userEmail String
  timestamp DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model MaterialInward {
  id             String   @id @default(uuid())
  inwardNumber   String
  date           DateTime @default(now())
  materialName   String
  quantity       Float
  unit           String
  supplierName   String
  vehicleNumber  String?
  challanNumber  String?
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  receivedBy     String?
  remarks        String?
  unitPrice      Float? // purchase rate (₹ per unit / MT)
  sourceLocation String? // GGBS source location
  brand          String? // Fly Ash brand
  mfgLocation    String? // Fly Ash manufacturing location
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([inwardNumber, tenantId])
}

model RMCGrade {
  id               String   @id @default(uuid())
  grade            String // M20, M25, M30, M35 etc.
  mixRatio         String? // e.g. 1:1.5:3
  cementContent    Float? // in kg/m3
  waterCementRatio Float? // e.g. 0.45
  admixture        String? // e.g. superplasticizer
  description      String?
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([grade, tenantId])
}

model Scrap {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  materialType String // Steel, Concrete, Wood etc.
  quantity     Float
  unit         String // tons, kg, units
  siteId       String?
  site         Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  saleStatus   String   @default("stored") // stored, sold, disposed
  saleValue    Float?
  buyerName    String?
  remarks      String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OverheadEntry {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  // Machinery | Fuel | Raw Material | Manpower | Electricity | Maintenance | Scrap | legacy categories
  category    String
  description String?
  quantity    Float?
  unit        String? // cum, sqm, bags, tons, trips, litres, MT
  amount      Float
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  customData  Json? // rate, remarks, personnelDetails, plantName, monthYearStr, avgFuelConsumption, costPerCuM
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomColumn {
  id        String   @id @default(uuid())
  entity    String
  name      String
  key       String
  type      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
}

model BillOfMaterial {
  id                 String        @id @default(uuid())
  code               String?       // e.g. BOM-M25-01
  name               String        // e.g. Standard M25 Mix Design
  gradeId            String?
  gradeName          String        // e.g. M25, M30
  siteId             String?
  site               Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  version            Int           @default(1)
  status             String        @default("draft") // draft, pending_approval, approved, archived
  effectiveFrom      DateTime      @default(now())
  effectiveTo        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  remarks            String?
  targetSlump        String?       // e.g. 120-150 mm
  density            Float?        // e.g. 2400 kg/m3
  standardCostPerCuM Float         @default(0)
  items              BOMItem[]
  revisions          BOMRevision[]
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([tenantId, gradeName])
  @@index([tenantId, status])
}

model BOMItem {
  id               String         @id @default(uuid())
  bomId            String
  bom              BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialName     String         // Cement (OPC 53), 20mm Aggregate, 10mm Aggregate, Sand, Fly Ash, Admixture, Water
  materialCategory String?        // Cementitious, Coarse Aggregate, Fine Aggregate, Water, Chemical Admixture
  standardQty      Float          // Standard qty per 1 CuM
  unit             String         // kg, L, MT, bags
  wastagePercent   Float          @default(0) // e.g. 1.5%
  standardRate     Float          @default(0) // Standard ₹ per unit
  standardCost     Float          @default(0) // standardQty * (1 + wastage%/100) * standardRate
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([bomId])
}

model BOMRevision {
  id             String         @id @default(uuid())
  bomId          String
  bom            BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  revisionNumber Int
  changeReason   String?
  previousCost   Float?
  newCost        Float?
  changedBy      String?
  snapshot       Json           // Complete JSON snapshot of items and rates
  createdAt      DateTime       @default(now())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bomId])
}

